# SoundTouch Open Cloud — Environment Configuration
# Copy this file to /data/.env and edit as needed.
# All values are optional; defaults work for most setups.

# Network
STOC_HOST=0.0.0.0
STOC_PORT=7777

# Device Discovery
STOC_DISCOVERY_ENABLED=true
STOC_DISCOVERY_TIMEOUT=5

# Manual fallback IPs (comma-separated, if SSDP doesn't find your speakers)
# STOC_MANUAL_DEVICE_IPS=192.168.1.50,192.168.1.51

# GitHub repo for update checks (format: owner/repo)
STOC_GITHUB_REPO=grimo77/SoundFlow

# Database path (inside the container, usually don't change this)
STOC_DB_PATH=/data/stoc.db

# Port for the web UI and API (default: 7777)
# Change this if port 7777 is already in use on your system.
# After changing, access the UI at http://localhost:<PORT>
STOC_PORT=7777
